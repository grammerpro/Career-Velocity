// ============================================================================
// CareerVelocity — Prisma Schema
// Database: PostgreSQL (Supabase)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum SubscriptionStatus {
  FREE
  PRO_1M
  PRO_6M
}

enum ApplicationStatus {
  SAVED
  TAILORING
  APPLIED
  INTERVIEW
  REJECTED
  OFFER
}

// ============================================================================
// NextAuth.js Required Models (Prisma Adapter)
// ============================================================================

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Core Domain Models
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // OAuth identifiers
  googleId   String? @unique @map("google_id")
  linkedinId String? @unique @map("linkedin_id")

  // Stripe billing
  stripeCustomerId String? @unique @map("stripe_customer_id")

  // Subscription & quotas
  subscriptionStatus SubscriptionStatus @default(FREE) @map("subscription_status")
  aiQuotaLimit       Int                @default(5) @map("ai_quota_limit")
  aiQuotaUsed        Int                @default(0) @map("ai_quota_used")
  quotaResetDate     DateTime?          @map("quota_reset_date")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts        Account[]
  sessions        Session[]
  baseResumes     BaseResume[]
  jobApplications JobApplication[]
  purchaseHistory PurchaseHistory[]

  @@index([subscriptionStatus])
  @@map("users")
}

model BaseResume {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  title  String @default("Untitled Resume")

  // Structured resume data stored as JSON
  education   Json @default("[]")
  workHistory Json @default("[]") @map("work_history")
  skills      Json @default("[]")
  projects    Json @default("[]")
  summary     String? @db.Text

  // Original uploaded file
  s3Url        String? @map("s3_url")
  s3Key        String? @map("s3_key")
  originalName String? @map("original_name")
  mimeType     String? @map("mime_type")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("base_resumes")
}

model JobApplication {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Job details
  companyName    String          @map("company_name")
  jobTitle       String          @map("job_title")
  jobUrl         String?         @map("job_url")
  rawDescription String          @map("raw_description") @db.Text
  location       String?
  salaryRange    String?         @map("salary_range")

  // Application tracking
  status          ApplicationStatus @default(SAVED)
  applicationDate DateTime?         @map("application_date")
  notes           String?           @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoredDocument TailoredDocument?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("job_applications")
}

model TailoredDocument {
  id               String @id @default(uuid()) @db.Uuid
  jobApplicationId String @unique @map("job_application_id") @db.Uuid

  // Tailored content
  tailoredResume  Json    @map("tailored_resume")
  coverLetterText String? @map("cover_letter_text") @db.Text

  // ATS optimization
  atsScore        Float?  @map("ats_score")
  keywordMatches  Json?   @map("keyword_matches")
  suggestions     Json?

  // Compiled PDF output
  s3PdfUrl String? @map("s3_pdf_url")
  s3PdfKey String? @map("s3_pdf_key")

  // AI generation metadata
  modelUsed    String?  @map("model_used")
  tokensUsed   Int?     @map("tokens_used")
  generatedAt  DateTime @default(now()) @map("generated_at")
  
  // Interview Preparation caching
  interviewPrep Json?   @map("interview_prep")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations (1:1 with JobApplication, cascade on delete)
  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@map("tailored_documents")
}

model DigitalProduct {
  id          String @id @default(uuid()) @db.Uuid
  sku         String @unique
  name        String
  description String @db.Text
  price       Decimal @db.Decimal(10, 2)

  // Access & delivery
  accessUrl   String? @map("access_url")
  isActive    Boolean @default(true) @map("is_active")
  productType String? @map("product_type") // e.g., "template", "guide", "course"

  // Stripe
  stripePriceId   String? @unique @map("stripe_price_id")
  stripeProductId String? @unique @map("stripe_product_id")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseHistory PurchaseHistory[]

  @@index([isActive])
  @@map("digital_products")
}

model PurchaseHistory {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Transaction details
  digitalProductId    String  @map("digital_product_id") @db.Uuid
  stripeTransactionId String? @unique @map("stripe_transaction_id")
  amount              Decimal @db.Decimal(10, 2)
  currency            String  @default("usd")

  // Status
  status    String  @default("completed") // completed, refunded, disputed
  receiptUrl String? @map("receipt_url")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalProduct DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([digitalProductId])
  @@map("purchase_history")
}
