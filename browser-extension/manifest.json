{
    "manifest_version": 3,
    "name": "CareerVelocity — AI Resume Optimizer",
    "version": "1.0.0",
    "description": "Instantly tailor your resume to any job posting on LinkedIn, Indeed, and more. One click — zero context switching.",
    "permissions": [
        "storage",
        "activeTab",
        "sidePanel"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://www.indeed.com/*",
        "https://indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/jobs/*",
                "https://www.indeed.com/viewjob*",
                "https://www.indeed.com/jobs*",
                "https://www.glassdoor.com/job-listing/*",
                "https://boards.greenhouse.io/*/jobs/*",
                "https://jobs.lever.co/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "side_panel": {
        "default_path": "sidebar.html"
    },
    "action": {
        "default_title": "CareerVelocity",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}